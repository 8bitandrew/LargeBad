@model global::LargeBad.Models.UserProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="large-center-post bg-1" id="slide-fast" style="display: none;">
    <div class="col-md-12">
        <h1 style="font-size: 75px">@ViewData["Title"]</h1>
        <hr />
        <br />
        <h2>Username: @Model.Nickname</h2>
        <br />
        <h2>Email: @Model.EmailAddress</h2>
    </div>
</div>