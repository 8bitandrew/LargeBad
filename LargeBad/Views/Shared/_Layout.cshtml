<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - The Large Bad</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" type="text/css" href="~/Content/large-bad-style.css">
</head>
<body class="disable-select">
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("TheLargeBad", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    @*<li>@Html.ActionLink("Home", "Index", "Home")</li>*@
                    <li>@Html.ActionLink("About", "About", "Home")</li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li>@Html.ActionLink("Downloads", "Downloads", "Home")</li>
                        <li>@Html.ActionLink("Apps", null, null, new { onclick = "javascript:return false;" })</li>
                        <li>@Html.ActionLink("Forum", null, null, new { onclick = "javascript:return false;" })</li>
                    }
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @*<li>@Html.ActionLink("SignUp", "SignUp", "Home")</li>*@

                    @*<li>@Html.ActionLink("SignUp", "Create", "Users")</li>
                        <li>@Html.ActionLink("Login", "Login", "Home")</li>*@
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li>@Html.ActionLink("Hello " + User.Identity.Name, "UserProfile", "Home")</li>
                        <li>@Html.ActionLink("Logout", "Logout", "Home")</li>
                    }
                    else
                    {
                        <li>@Html.ActionLink("Login", "Login", "Home")</li>
                    }

                </ul>
            </div>
        </div>
    </div>

    <div class="main-content" style="position: relative">
        <canvas id="lamp-anim" style="position: absolute; width: 100%; height: 100%;"></canvas>
        @RenderBody()
    </div>

    <div class="bg-4 text-center navbar" style="padding-top: 25px;
    padding-bottom: 25px; margin: 0px; font-size: 16px;">
        &copy; @DateTime.Now.Year - Andrew & Eric
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/Scripts/App/view-layout-script.js")
    @Scripts.Render("~/Scripts/App/lava-lamp-effect.js")
    @RenderSection("scripts", required: false)
</body>
</html>